# PSYCHE AI — Repository Security & Hygiene Ignore Rules

# Secrets, Keys, Certificates & Credentials (NEVER COMMIT)
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore
local.properties
.env
.env.*
!.env.example

# Private Databases, Vaults & Vector Stores (NEVER COMMIT)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlcipher
*.npy
*.npz
Vault/
Snapshots/

# Local AI Model Weights & Binaries
*.gguf
*.bin
*.onnx
*.safetensors
*.pt
*.pth

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
dist/
build/
*.egg-info/

# Android / Gradle Artifacts (Lenovo LOQ)
.gradle/
**/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# IDE & OS Files
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
