{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psyche.local/contracts/v1/notification_ingest.schema.json",
  "title": "PSYCHE AI Notification Acquisition & Ingest Contract (v1.0.0)",
  "description": "Batch notification ingest contract from Android Companion (Lenovo LOQ) to Windows Desktop Companion (Legion 5 Pro) over mTLS 1.3. Enforces verbatim message preservation and untrusted external input isolation.",
  "$defs": {
    "NotificationEventItem": {
      "type": "object",
      "required": [
        "event_id",
        "package_name",
        "notification_category",
        "conversation_key",
        "is_group_conversation",
        "direction",
        "sender",
        "content",
        "posted_at_utc",
        "security"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "package_name": { "type": "string", "minLength": 1, "examples": ["com.whatsapp", "com.google.android.apps.messaging"] },
        "notification_category": { "type": "string", "enum": ["msg", "call", "email", "social", "system_allowed"] },
        "conversation_key": { "type": "string", "minLength": 1 },
        "is_group_conversation": { "type": "boolean" },
        "group_title": { "type": ["string", "null"] },
        "direction": { "type": "string", "enum": ["INBOUND", "OUTBOUND_OBSERVED"] },
        "sender": {
          "type": "object",
          "required": ["raw_title", "identity_ambiguity"],
          "additionalProperties": false,
          "properties": {
            "raw_title": { "type": "string", "minLength": 1 },
            "android_contact_lookup_key": { "type": ["string", "null"] },
            "normalized_phone_sha256": {
              "oneOf": [
                { "$ref": "common.schema.json#/$defs/Sha256Hex" },
                { "type": "null" }
              ]
            },
            "candidate_person_ids": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
            },
            "identity_ambiguity": { "type": "boolean" }
          }
        },
        "content": {
          "type": "object",
          "required": [
            "raw_text_immutable",
            "raw_text_sha256",
            "detected_language_modes"
          ],
          "additionalProperties": false,
          "properties": {
            "raw_text_immutable": {
              "type": "string",
              "minLength": 1,
              "description": "Exact UTF-8 string from Android StatusBarNotification. Must never be overwritten or normalized in place."
            },
            "raw_text_sha256": { "$ref": "common.schema.json#/$defs/Sha256Hex" },
            "detected_language_modes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/LanguageMode" }
            },
            "token_language_spans": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/TokenLanguageSpan" }
            }
          }
        },
        "posted_at_utc": { "$ref": "common.schema.json#/$defs/TimestampUtc" },
        "security": {
          "type": "object",
          "required": ["untrusted_external_input", "otp_or_sensitive_filtered", "ed25519_event_signature"],
          "additionalProperties": false,
          "properties": {
            "untrusted_external_input": {
              "type": "boolean",
              "const": true,
              "description": "Mandatory invariant: all incoming notifications are untrusted external input."
            },
            "otp_or_sensitive_filtered": {
              "type": "boolean",
              "const": true,
              "description": "Confirms Android OTP/banking exclusion filter ran before queueing."
            },
            "ed25519_event_signature": { "$ref": "common.schema.json#/$defs/Base64Signature" }
          }
        }
      }
    },
    "NotificationIngestRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "batch_id",
        "device_id",
        "sent_at_utc",
        "events",
        "batch_ed25519_signature"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "batch_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "device_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "sent_at_utc": { "$ref": "common.schema.json#/$defs/TimestampUtc" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/NotificationEventItem" }
        },
        "batch_ed25519_signature": { "$ref": "common.schema.json#/$defs/Base64Signature" }
      }
    },
    "NotificationIngestResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "batch_id",
        "processed_at_utc",
        "acked_event_ids",
        "duplicate_event_ids",
        "rejected_events"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "batch_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
        "processed_at_utc": { "$ref": "common.schema.json#/$defs/TimestampUtc" },
        "acked_event_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
        },
        "duplicate_event_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/UuidV7" }
        },
        "rejected_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "error_code", "reason"],
            "additionalProperties": false,
            "properties": {
              "event_id": { "$ref": "common.schema.json#/$defs/UuidV7" },
              "error_code": {
                "type": "string",
                "enum": ["INVALID_SIGNATURE", "SHA256_MISMATCH", "SCHEMA_VIOLATION", "CLOCK_SKEW_EXCEEDED"]
              },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
